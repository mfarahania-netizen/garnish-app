# Garnish OS — server environment template (E1)
# Copy to `apps/server/.env` and fill with REAL values.
# NEVER commit the real .env — it is git-ignored. If a secret leaks, rotate it
# immediately and log the rotation in docs/execution/DECISION_LOG.md.

# PostgreSQL connection string (required)
DATABASE_URL="postgresql://username:password@localhost:5432/garnish_db"

# JWT signing secret (required) — generate with: openssl rand -base64 64
JWT_SECRET="your-strong-random-secret-here"

# Google Gemini API key (required ONLY when AI_PROVIDER=gemini AND AI_LIVE_ENABLED=true; optional on the default
# stub/dev path). Placeholder only — never commit a real key.
GEMINI_API_KEY="your-gemini-api-key"

# AI Core provider selection (E47-A5). SAFE DEFAULT = stub (no live LLM).
# Live Gemini is used ONLY when AI_PROVIDER=gemini AND AI_LIVE_ENABLED=true AND a real GEMINI_API_KEY is set.
AI_PROVIDER="stub"              # stub | gemini
AI_LIVE_ENABLED="false"         # must be exactly "true" to enable a live provider
AI_MODEL_NAME="gemini-2.5-flash"

# Redis (optional — defaults: localhost:6379)
REDIS_HOST=localhost
REDIS_PORT=6379

# Frontend origin for CORS (optional — default: http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# Server port (optional — default: 3000)
PORT=3000
