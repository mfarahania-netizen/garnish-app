# Garnish server environment template
# Copy to apps/server/.env and fill with REAL values.
# NEVER commit the real .env. If a secret leaks, rotate it immediately.

# PostgreSQL connection string (required)
DATABASE_URL="postgresql://username:password@localhost:5432/garnish_db"

# JWT signing secret (required) - generate with: openssl rand -base64 64
JWT_SECRET="your-strong-random-secret-here"

# Google Gemini API key (required only when AI_PROVIDER=gemini and AI_LIVE_ENABLED=true)
GEMINI_API_KEY="your-gemini-api-key"

# AI Core provider selection. Safe default: stub (no live LLM).
AI_PROVIDER="stub"
AI_LIVE_ENABLED="false"
AI_MODEL_NAME="gemini-3.1-flash-lite"

# Redis (optional - defaults: localhost:6379)
REDIS_HOST=localhost
REDIS_PORT=6379

# Frontend origin for CORS (optional - default: http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# SMS OTP (safe default: disabled; put the real API key only in apps/server/.env)
SMS_PROVIDER=melipayamak
MELIPAYAMAK_API_KEY=PUT_REAL_KEY_IN_ENV_ONLY
MELIPAYAMAK_PATTERN_BODY_ID=PUT_REAL_BODY_ID_IN_ENV_ONLY
MELIPAYAMAK_ENABLED=false

# Required when Melipayamak is enabled.
MELIPAYAMAK_USERNAME=
SMS_PROVIDER_TIMEOUT_MS=5000
# Raw OTP output is allowed only for explicit development/test runs. Keep false elsewhere.
SMS_DEV_LOG_OTP=false

OTP_TTL_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_DAILY_LIMIT_PER_PHONE=10

# Google Identity Services ID token flow (no client secret)
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Optional analytics/personalization processing remains fail-closed. Legal approval is required before either is true.
OPTIONAL_ANALYTICS_INGEST_ENABLED=false
OPTIONAL_PERSONALIZATION_PROCESSING_ENABLED=false

# Household H1/H2 is dark by default. This is a global kill switch, not a cohort
# allowlist. When enabled, use an independent random pepper (min 32 chars) for
# one-way invite target binding; never reuse JWT_SECRET.
HOUSEHOLD_V1_ENABLED=false
HOUSEHOLD_INVITE_PEPPER=

# Server port (optional - default: 3000)
PORT=3000
# Number of trusted reverse-proxy hops. Keep 0 unless ingress is network-locked
# to an exact proxy chain; never enable this just to accept arbitrary XFF.
TRUST_PROXY_HOPS=0
