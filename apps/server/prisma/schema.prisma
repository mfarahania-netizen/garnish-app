// apps/server/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  phone     String?  @unique
  email     String?  @unique
  name      String?
  avatar    String? // 🆕 آواتار کاربر
  password  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  preferences                UserPreference?
  recipes                    Recipe[]                         @relation("UserRecipes")
  favorites                  FavoriteRecipe[]
  mealPlans                  MealPlan[]
  shoppingList               ShoppingList[]
  notifications              Notification[]
  tickets                    SupportTicket[]
  sessions                   UserSession[]
  events                     UserEvent[]
  recommendationExposures    RecommendationExposure[]
  featureContributionLogs    FeatureContributionLog[]
  recommendationAttributions RecommendationAttributionEvent[]
  profile                    UserBehaviorProfile?
  isAdmin                    Boolean                          @default(false)
  auditLogs                  UserAuditLog[]
  dataAccessLogs             DataAccessLog[]
  consentLogs                ConsentLog[]
  preferenceHistories        PreferenceHistory[]

  allergies   UserAllergy[]
  cuisines    UserCuisine[]
  healthGoals UserHealthGoal[]

  // AI Core v1 (E47-A2) — additive
  aiCallLogs   AICallLog[]
  chatMessages ChatMessage[]
  userFacts    UserFact[]
  aiSpendAlerts AiSpendAlert[] // E47-A10C spend-alert foundation (SetNull on delete)

  // E39-1A erasure FK repair — behavioral / intelligence relations (additive)
  featureVector         UserFeatureVector?
  features              UserFeature[]
  outcomes              UserOutcome[]
  identityDimensions    UserIdentityDimension[]
  behaviorTimelines     UserBehaviorTimeline[]
  signalObservations    SignalObservation[]
  behaviorSignals       UserBehaviorSignal[]
  engagementSnapshot    UserEngagementSnapshot?
  healthSnapshot        UserHealthSnapshot?
  identitySnapshot      UserIdentitySnapshot?
  retentionSnapshot     UserRetentionSnapshot?
  experimentAssignments ExperimentAssignment[]

  // E39-1B erasure-proof ledger (audit-long; SetNull so it survives deletion)
  erasureEvents ErasureEvent[]

  // GAMIFY-L4-11 — honest gamification (additive; all Cascade → erasure-safe)
  gamificationStreak       UserStreak?
  gamificationAchievements UserAchievement[]
  gamificationProgress     UserProgress[]
  gamificationEvents       GamificationEvent[]

  // L0 — living-intelligence core (additive; Cascade → erasure-safe)
  userConsents UserConsent[]
  pantryItems  PantryItem[]
}

model UserPreference {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  diet       String?
  skillLevel String?
  budget     String?
  updatedAt  DateTime @updatedAt
}

model Allergy {
  id    String        @id @default(uuid())
  name  String        @unique
  users UserAllergy[]

  @@map("allergies")
}

model Cuisine {
  id    String        @id @default(uuid())
  name  String        @unique
  users UserCuisine[]

  @@map("cuisines")
}

model HealthGoal {
  id    String           @id @default(uuid())
  name  String           @unique
  users UserHealthGoal[]

  @@map("health_goals")
}

model UserAllergy {
  userId    String
  allergyId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  allergy   Allergy @relation(fields: [allergyId], references: [id], onDelete: Cascade)

  @@id([userId, allergyId])
  @@map("user_allergies")
}

model UserCuisine {
  userId    String
  cuisineId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  cuisine   Cuisine @relation(fields: [cuisineId], references: [id], onDelete: Cascade)

  @@id([userId, cuisineId])
  @@map("user_cuisines")
}

model UserHealthGoal {
  userId       String
  healthGoalId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  healthGoal   HealthGoal @relation(fields: [healthGoalId], references: [id], onDelete: Cascade)

  @@id([userId, healthGoalId])
  @@map("user_health_goals")
}

model Recipe {
  id          String   @id @default(uuid())
  title       String
  description String?
  category    String
  region      String?
  difficulty  String?
  cookingTime Int?
  servings    Int?
  imageUrl    String?
  videoUrl    String?
  authorId    String?
  author      User?    @relation("UserRecipes", fields: [authorId], references: [id], onDelete: SetNull)
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  status    String? @default("pending")
  adminNote String?

  prepTime   String?
  totalTime  String?
  tools      String? @default("[]")
  tips       String? @default("[]")
  faq        String? @default("[]")
  mealType   String?
  diet       String?
  categories String? @default("[]")
  allergens  String? @default("[]")
  occasion   String? @default("[]")
  cost       String?

  // S3 Option-2 — structured richness (additive; display-only). The importer previously flattened these
  // four authored arrays into one `tips` blob; now persisted separately so the UI can render distinct
  // premium sections. `dishType` is the authored classification (display-only — the S5 course gate still
  // derives course from category+mealType and is NOT repointed here). None is safety-relevant.
  chefTips           String? @default("[]")
  commonMistakes     String? @default("[]")
  servingSuggestions String? @default("[]")
  substitutions      String? @default("[]")
  dishType           String? @default("[]")

  // GRIS v2 — the full Garnish Recipe Intelligence Standard object (story, whyItWorks, glance, skillsLearned,
  // dietary, rich ingredients/steps, finish, troubleshooting, variations, keep, serveWith, nourishment, faq).
  // Additive Json blob; the recipe page renders it when present, with graceful fallback to the flat fields.
  gris         Json?
  // GRIS dietary surface (queryable for the planner/preference filter; soft "no pork" avoidance).
  containsPork Boolean @default(false)

  ingredients                     RecipeIngredient[]
  steps                           RecipeStep[]
  nutrition                       Nutrition?
  searchTerms                     SearchTerm[]
  favoriteBy                      FavoriteRecipe[]
  mealSlots                       MealSlot[]
  recommendationExposures         RecommendationExposure[]
  featureContributionLogs         FeatureContributionLog[]
  recommendationAttributionEvents RecommendationAttributionEvent[]
}

model Ingredient {
  id                  String   @id
  code                String   @unique
  status              String?
  version             String?
  batch               Json?
  nameFa              String?
  nameEn              String?
  category            String?
  subCategory         String?
  ingredientState     Json?
  dietFlags           Json?
  allergens           Json?
  nutritionPer100g    Json?
  nutritionConfidence Json?
  tasteProfile        Json?
  textureProfile      Json?
  cookingBehavior     Json?
  healthContext       Json?
  substitutionOptions Json?
  media               Json?
  aiContext           Json?
  marketAvailability  Json?
  cuisineRelevance    Json?
  dataQuality         Json?
  recipeInputAliases  Json?
  resolverDefaults    Json?
  raw                 Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  recipeIngredients RecipeIngredient[]
  pantryItems       PantryItem[] // L0 (SetNull on delete → pantry rows survive a dictionary edit)

  @@index([category])
  @@index([code])
}

model RecipeIngredient {
  id           String      @id @default(uuid())
  recipeId     String
  recipe       Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String?
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  name         String
  amount       String?
  unit         String?
  notes        String?
  order        Int         @default(0)

  @@index([ingredientId])
}

model RecipeStep {
  id          String  @id @default(uuid())
  recipeId    String
  recipe      Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  title       String?
  instruction String
  duration    Int?
  imageUrl    String?
  order       Int     @default(0)
}

model Nutrition {
  id       String @id @default(uuid())
  recipeId String @unique
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  calories Float?
  protein  Float?
  carbs    Float?
  fat      Float?
  fiber    Float?
}

model SearchTerm {
  id       String @id @default(uuid())
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  term     String
}

model FavoriteRecipe {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId String
  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  addedAt  DateTime @default(now())

  @@unique([userId, recipeId])
}

model MealPlan {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slots MealSlot[]

  @@unique([userId, weekStart])
}

model MealSlot {
  id         String   @id @default(uuid())
  mealPlanId String
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  dayOfWeek  Int
  mealType   String
  recipeId   String?
  recipe     Recipe?  @relation(fields: [recipeId], references: [id])
  notes      String?
}

model ShoppingList {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ShoppingItem[]
}

model ShoppingItem {
  id             String       @id @default(uuid())
  shoppingListId String
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  name           String
  amount         String?
  unit           String?
  isChecked      Boolean      @default(false)
  category       String?
  addedAt        DateTime     @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String
  isRead    Boolean  @default(false)
  data      String?
  createdAt DateTime @default(now())
}

model SupportTicket {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  message   String
  status    String   @default("open")
  priority  String   @default("normal")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  replies TicketReply[]
}

model TicketReply {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message   String
  isStaff   Boolean       @default(false)
  createdAt DateTime      @default(now())
}

// ===== مدل‌های ردیابی رفتار کاربران =====

model UserSession {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  startTime DateTime    @default(now())
  endTime   DateTime?
  device    String?
  ip        String?
  events    UserEvent[]
}

model UserEvent {
  id                 String              @id @default(uuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type               String
  timestamp          DateTime            @default(now())
  sessionId          String?
  session            UserSession?        @relation(fields: [sessionId], references: [id])
  page               String?
  duration           Int?
  payload            String?
  enrichment         String?
  recipeId           String? // L0: denormalized from payload at write-time for fast recipe-level signal queries (nullable → existing rows + reader unchanged)
  signalObservations SignalObservation[] // 👈 اضافه شد

  @@index([userId, type, timestamp])
  @@index([timestamp])
  @@index([type])
  @@index([userId, recipeId, timestamp])
}

model UserBehaviorProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  favoriteFoods    String? @default("[]")
  dislikedFoods    String? @default("[]")
  budgetRange      String?
  shoppingPattern  String? @default("[]")
  mealTiming       String? @default("{}")
  cookingSkill     String?
  healthGoals      String? @default("[]")
  motivationStyle  String?
  consistencyScore Float?  @default(0.0)
  churnRiskScore   Float?  @default(0.0)
  familySize       Int?    @default(1)

  favoriteIngredients  String? @default("[]")
  dislikedIngredients  String? @default("[]")
  preferredMealTimes   String? @default("{}")
  weeklyPatterns       String? @default("{}")
  cookingFrequency     String?
  budgetScore          String?
  healthAdherenceScore Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===== جداول ممیزی برای GDPR =====

model UserAuditLog {
  id        String   @id @default(uuid())
  userId    String? // E39-1B: nullable for audit-long survival (SetNull on erasure)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model DataAccessLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  resource   String
  action     String
  details    String?
  ip         String?
  accessedAt DateTime @default(now())

  @@index([userId, accessedAt])
}

model ConsentLog {
  id        String   @id @default(uuid())
  userId    String? // E39-1B: nullable for audit-long survival (SetNull on erasure)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      String
  // E52/B2B-B0: processing purpose the user consented to (additive, nullable).
  // Mirrors the canonical envelope consentPurpose: core | analytics | personalization | b2b_aggregate | community.
  purpose   String?
  granted   Boolean  @default(true)
  ip        String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type])
}

// E39-1B: audit-long, PII-FREE erasure-proof ledger. Survives user deletion (userId SetNull on
// erasure; `subjectHash` is the durable, non-reversible subject reference). Written by the future
// transactional erasure service (E39-1C). No email/phone/name/raw profile/secrets stored.
model ErasureEvent {
  id          String   @id @default(uuid())
  userId      String? // SetNull on erasure — proof survives without an active user link
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  subjectHash String // sha256(salt + userId) — non-reversible reference to the (deleted) subject
  action      String // e.g. user_erasure_requested | user_erasure_completed
  status      String // requested | completed | failed
  reason      String?
  metadata    Json // PII-free only (assertNoPIIInMetadata enforced in ErasureAuditService)
  createdAt   DateTime @default(now())

  @@index([subjectHash, createdAt])
  @@index([action, status])
}

model PreferenceHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fieldName String
  oldValue  String?
  newValue  String?
  changedAt DateTime @default(now())

  @@index([userId, changedAt])
}

// ===== 🆕 مدل‌های Feature Store =====

model UserFeatureVector {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  features  Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}

model UserFeature {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  featureKey String
  value      Float    @default(0.0)
  updatedAt  DateTime @updatedAt

  @@unique([userId, featureKey])
  @@index([featureKey, value])
}

// ===== 🆕 مدل‌های لایه Outcomes =====

model UserOutcome {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  metricName         String
  baselineValue      Float?
  metricValue        Float    @default(0.0)
  improvementPercent Float?
  trend              Float?
  period             String   @default("weekly")
  sources            Json?
  recordedAt         DateTime @default(now())

  @@index([userId, metricName, recordedAt])
}

// ===== 🆕 مدل‌های Identity =====

model UserIdentityDimension {
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dimensionKey   String
  value          Float    @default(0.0)
  confidence     Float    @default(0.0)
  evidenceCount  Int      @default(0)
  lastEvidenceAt DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@id([userId, dimensionKey])
}

model UserBehaviorTimeline {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dimensionKey String
  value        Float
  recordedAt   DateTime @default(now())

  @@index([userId, dimensionKey, recordedAt])
}

// ===== 🆕 مدل‌های Behavioral Signals =====

model SignalObservation {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  signalName String
  eventId    String
  weight     Float    @default(0.0)
  observedAt DateTime @default(now())

  // L0: full typed-signal contract (all nullable/defaulted → existing writer at
  // recipe.signal-processor.ts and reader at recommendation-shadow-a8-adapters.ts stay byte-identical).
  recipeId   String? // which recipe drove this signal (was unrecoverable; lived only in UserEvent.payload)
  dimension  String? // e.g. "taste" / "nutrition" — maps a row into a Food-DNA dimension
  value      String? // e.g. cuisine token "persian" — the typed value carried by the signal
  confidence Float? // per-observation evidence strength (cook=1 > favorite=0.8 > view=0.5)
  source     String?  @default("legacy_event") // event type / extractor that produced it

  event UserEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId, signalName, observedAt])
  @@index([userId, recipeId])
}

// L0 — consent-at-ingest (opt-IN, versioned, point-in-time, with lawful basis). Deliberately SEPARATE
// from ConsentLog (which is opt-OUT latest-state, audit_long, read by erasure/export/retention) so those
// consumers stay byte-identical. Purpose strings are constrained in app code to ConsentPurposeEnum
// (core | analytics | personalization | b2b_aggregate | community | notifications). Operational gating
// record → Cascade (the legal proof survives via ConsentLog + ErasureEvent).
model UserConsent {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose       String
  status        String    @default("granted") // granted | withdrawn
  lawfulBasis   String    @default("consent") // consent | legitimate_interest | contract
  policyVersion String?
  source        String? // onboarding | settings | api | ingest
  ip            String?
  grantedAt     DateTime  @default(now())
  withdrawnAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, purpose])
}

// L0 — user pantry / on-hand inventory (feeds pantry-aware personalization + shopping de-dup). Mirrors
// the ShoppingItem shape. ingredientId is a soft link (SetNull) so a dictionary edit never drops a pantry row.
model PantryItem {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredientId String?
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  name         String
  amount       String?
  unit         String?
  addedAt      DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId])
  @@index([ingredientId])
}

model RecommendationExposure {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId     String
  recipe       Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  source       String   @default("recommendation")
  viewedAt     DateTime @default(now())
  scorePenalty Float    @default(0.0)

  @@index([userId, recipeId, viewedAt])
}

model FeatureContributionLog {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId     String
  recipe       Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  featureKey   String
  contribution Float
  finalScore   Float
  createdAt    DateTime @default(now())

  @@index([userId, recipeId, createdAt])
  @@index([featureKey, contribution])
}

model RecommendationAttributionEvent {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId   String
  recipe     Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  eventType  String
  value      Float    @default(0.0)
  source     String   @default("recommendation")
  occurredAt DateTime @default(now())

  @@index([userId, recipeId, occurredAt])
  @@index([eventType, value])
}

model RecommendationMetrics {
  id                    String   @id @default(uuid())
  metricDate            DateTime @default(now())
  windowDays            Int      @default(7)
  totalImpressions      Int      @default(0)
  totalClicks           Int      @default(0)
  totalSaves            Int      @default(0)
  totalCooks            Int      @default(0)
  totalDismisses        Int      @default(0)
  totalExposures        Int      @default(0)
  clickThroughRate      Float    @default(0.0)
  saveRate              Float    @default(0.0)
  cookRate              Float    @default(0.0)
  frictionRate          Float    @default(0.0)
  recommendationQuality Float    @default(0.0)
  recommendationReward  Float    @default(0.0)
  topSignals            Json?
  topFeatures           Json?
  createdAt             DateTime @default(now())

  @@unique([metricDate, windowDays])
  @@index([metricDate, windowDays])
}

// E18/E43-A7: redacted SHADOW recommendation decision trace (additive, no FK, default writes OFF).
// Stores ONLY minimized/redacted shadow comparison data — never raw recipe body, raw user text, AI
// prompt/output, PII, or medical/protected labels. Not user-facing; does not affect live ranking.
model RecommendationShadowTrace {
  id                String   @id @default(uuid())
  userId            String?
  requestId         String?
  experimentKey     String?
  liveFingerprint   String
  shadowFingerprint String
  topKOverlap       Float?
  rankShiftCount    Int?
  majorDivergence   Boolean
  reasonCodes       Json
  summary           Json
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([experimentKey])
  @@index([createdAt])
}

model UserBehaviorSignal {
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  signalName   String
  signalDomain String
  signalType   String
  value        Float    @default(0.0)
  confidence   Float    @default(0.0)
  sampleSize   Int      @default(0)
  consistency  Float    @default(0.0)
  halfLifeDays Int      @default(30)
  lastDetected DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@id([userId, signalName])
}

// ===== 🆕 Domain Snapshots =====

model UserEngagementSnapshot {
  userId                 String   @id
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avgSessionDuration     Float    @default(0.0)
  avgTimeBetweenSessions Float    @default(0.0)
  daysSinceLastMealPlan  Int      @default(0)
  activeDaysLast30       Int      @default(0)
  schemaVersion          Int      @default(1)
  updatedAt              DateTime @updatedAt
}

model UserHealthSnapshot {
  userId                 String   @id
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealPlanCompletionRate Float    @default(0.0)
  goalCompletionRate     Float    @default(0.0)
  nutritionViewFrequency Float    @default(0.0)
  hasActiveHealthGoal    Boolean  @default(false)
  schemaVersion          Int      @default(1)
  updatedAt              DateTime @updatedAt
}

model UserIdentitySnapshot {
  userId                 String   @id
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeSaveRate         Float    @default(0.0)
  recipeCookRate         Float    @default(0.0)
  shoppingCompletionRate Float    @default(0.0)
  aiAcceptanceRate       Float    @default(0.0)
  aiDismissRate          Float    @default(0.0)
  schemaVersion          Int      @default(1)
  updatedAt              DateTime @updatedAt
}

model UserRetentionSnapshot {
  userId              String   @id
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  daysSinceLastActive Int      @default(0)
  sessionTrend        Float    @default(0.0)
  engagementTrend     Float    @default(0.0)
  retentionScore      Float    @default(0.0)
  churnRisk           Float    @default(0.0)
  schemaVersion       Int      @default(1)
  updatedAt           DateTime @updatedAt
}

// ===== 🆕 مدل‌های A/B Testing =====

model Experiment {
  id        String   @id @default(uuid())
  name      String
  variantA  Json // وزن‌های گروه A
  variantB  Json // وزن‌های گروه B
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  assignments ExperimentAssignment[]
}

model ExperimentAssignment {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  experimentId String
  variant      String // "A" or "B"
  experiment   Experiment @relation(fields: [experimentId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([userId, experimentId])
}

// ============================================================
// AI Core v1 persistence (E47-A2) — ADDITIVE ONLY.
// Makes every orchestrator call auditable. No product-scope change.
// JSON columns store guard hits / tool calls / PII-free metadata.
// ============================================================

// Audit record for every AI call routed through the orchestrator (success or blocked).
model AICallLog {
  id                    String   @id @default(uuid())
  userId                String?
  user                  User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventId               String? // link to a canonical event envelope (ADR-0001)
  conversationId        String?
  surface               String?
  model                 String
  provider              String
  status                String // ok | blocked_injection | blocked_safety | blocked_nutrition | blocked_cost | error
  latencyMs             Int?
  estimatedInputTokens  Int?
  estimatedOutputTokens Int?
  estimatedCost         Float? // estimatedCostUsd — null until a per-model pricing table exists (no faked precision)
  // ── E47-A10A persisted cost/usage ledger fields (additive; R3 mitigation) ──
  totalTokens           Int? // input+output; provider-returned when available, else estimated
  usageSource           String? // 'provider' | 'estimated' | 'unavailable' (no provider call)
  costIsEstimated       Boolean? // true while estimatedCost is null / not precisely metered
  currency              String? // ISO currency for estimatedCost (e.g. 'USD'); null when no cost
  costSchemaVersion     Int? // ledger schema version for forward migration
  guardHits             Json // string[] — guard categories that fired
  toolCalls             Json // string[] — tool names invoked
  metadata              Json // PII-free only (assertNoPIIInMetadata enforced in the service)
  errorCode             String?
  errorMessage          String? // sanitized; never raw secrets/PII/prompt text
  createdAt             DateTime @default(now())

  @@index([userId, createdAt])
  @@index([status])
  @@index([conversationId])
  @@index([provider, model, createdAt])
}

// E47-A10C — spend-alert foundation (governance only; NOT billing, no charging).
// Persists a record when a per-user daily token/estimated-cost threshold is crossed. SetNull on user
// delete (erasure-safe). Best-effort app-level dedup per (userId, dayUtc, thresholdType) — not race-proof
// (no DB unique constraint); acceptable for dev/beta. Indexes are non-unique by design.
model AiSpendAlert {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  thresholdType  String // 'token_daily' | 'estimated_cost_daily'
  thresholdValue Float
  observedValue  Float
  provider       String?
  model          String?
  dayUtc         String // 'YYYY-MM-DD' (UTC)
  status         String // 'triggered' | 'resolved' | 'suppressed'
  severity       String // 'info' | 'warning' | 'critical'
  metadata       Json // PII-free only
  schemaVersion  Int
  createdAt      DateTime @default(now())

  @@index([userId, dayUtc])
  @@index([thresholdType, dayUtc])
}

// Persisted chat messages for AI Core v1 (no medical/vision claim expansion).
model ChatMessage {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId      String
  role                String // user | assistant | system | tool
  content             String
  contentSafetyStatus String?
  model               String?
  aiCallLogId         String?
  createdAt           DateTime @default(now())

  @@index([userId, createdAt])
  @@index([conversationId, createdAt])
}

// Safe, non-sensitive user memory/facts. Sensitive health/medical facts are rejected by the service.
model UserFact {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  key        String
  value      Json
  source     String
  confidence Float?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

// ============================================================
// GAMIFY-L4-11 — Honest gamification engine persistence — ADDITIVE ONLY.
// Server-authoritative: every row is derived from the trusted signal/event store
// (UserEvent type='cook_complete' etc.), NEVER client-asserted. All relations are
// onDelete: Cascade → erased automatically with the user (classified user_owned_active
// in retention-policy.ts). NO leaderboard/ranking/comparison data is ever stored.
// ============================================================

// One streak record per user. Weekly cadence (cook-days/week, not punishing daily pressure)
// with a single grace week ("freeze") so a busy week does not cruelly reset. Private only.
model UserStreak {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentWeeks Int      @default(0)
  longestWeeks Int      @default(0)
  graceUsed    Boolean  @default(false)
  lastCookWeek String? // ISO week key (e.g. 2026-W24) of the most recent counted week
  updatedAt    DateTime @updatedAt
}

// Unlocked achievements. (userId, achievementKey) unique → idempotent, no double-award.
model UserAchievement {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementKey String
  unlockedAt     DateTime @default(now())

  @@unique([userId, achievementKey])
  @@index([userId])
}

// Per-track mastery/progress (track = 'overall' or a cuisine/skill area). Honest, derived.
model UserProgress {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track     String
  level     Int      @default(1)
  levelName String   @default("novice")
  score     Float    @default(0)
  basis     String? // JSON explainability of how the level was earned
  updatedAt DateTime @updatedAt

  @@unique([userId, track])
  @@index([userId])
}

// Append-only award ledger. Each row records a real earned award (achievement/milestone/
// level-up) derived from signals — the anti-cheat record of truth.
model GamificationEvent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // 'achievement_unlocked' | 'streak_milestone' | 'mastery_levelup'
  refKey    String // achievementKey / milestone weeks / track
  detail    String? // JSON, PII-free
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
