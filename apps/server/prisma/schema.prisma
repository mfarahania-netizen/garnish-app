// ============================================================
// AI Core v1 persistence (E47-A2) — ADDITIVE ONLY.
// Makes every orchestrator call auditable. No product-scope change.
// JSON columns store guard hits / tool calls / PII-free metadata.
// ============================================================

// Audit record for every AI call routed through the orchestrator (success or blocked).
model AICallLog {
  id                    String   @id @default(uuid())
  userId                String?
  user                  User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventId               String? // link to a canonical event envelope (ADR-0001)
  conversationId        String?
  surface               String?
  model                 String
  provider              String
  status                String // ok | blocked_injection | blocked_safety | blocked_nutrition | blocked_cost | error
  latencyMs             Int?
  estimatedInputTokens  Int?
  estimatedOutputTokens Int?
  estimatedCost         Float? // estimatedCostUsd — null until a per-model pricing table exists (no faked precision)
  // ── E47-A10A persisted cost/usage ledger fields (additive; R3 mitigation) ──
  totalTokens           Int? // input+output; provider-returned when available, else estimated
  usageSource           String? // 'provider' | 'estimated' | 'unavailable' (no provider call)
  costIsEstimated       Boolean? // true while estimatedCost is null / not precisely metered
  currency              String? // ISO currency for estimatedCost (e.g. 'USD'); null when no cost
  costSchemaVersion     Int? // ledger schema version for forward migration
  intent                String? // P0 observability: deterministic intent label when known
  tier                  String? // P0 observability: NONE | CHEAP | STRONG | REFUSE | SPECIAL when known
  cacheHit              Boolean? // P0 observability: true only when a verified cache hit served the turn
  cacheTokens           Int? // P0 observability: provider-reported/verified cached tokens, null when unavailable
  guardHits             Json // string[] — guard categories that fired
  toolCalls             Json // string[] — tool names invoked
  metadata              Json // PII-free only (assertNoPIIInMetadata enforced in the service)
  errorCode             String?
  errorMessage          String? // sanitized; never raw secrets/PII/prompt text
  createdAt             DateTime @default(now())

  @@index([userId, createdAt])
  @@index([status])
  @@index([conversationId])
  @@index([provider, model, createdAt])
  @@index([intent, tier, createdAt])
  @@index([cacheHit, createdAt])
}

// E47-A10C — spend-alert foundation (governance only; NOT billing, no charging).
// Persists a record when a per-user daily token/estimated-cost threshold is crossed. SetNull on user
// delete (erasure-safe). Best-effort app-level dedup per (userId, dayUtc, thresholdType) — not race-proof
// (no DB unique constraint); acceptable for dev/beta. Indexes are non-unique by design.
model AiSpendAlert {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  thresholdType  String // 'token_daily' | 'estimated_cost_daily'
  thresholdValue Float
  observedValue  Float
  provider       String?
  model          String?
  dayUtc         String // 'YYYY-MM-DD' (UTC)
  status         String // 'triggered' | 'resolved' | 'suppressed'
  severity       String // 'info' | 'warning' | 'critical'
  metadata       Json // PII-free only
  schemaVersion  Int
  createdAt      DateTime @default(now())

  @@index([userId, dayUtc])
  @@index([thresholdType, dayUtc])
}

// Persisted chat messages for AI Core v1 (no medical/vision claim expansion).
model ChatMessage {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId      String
  role                String // user | assistant | system | tool
  content             String
  contentSafetyStatus String?
  model               String?
  aiCallLogId         String?
  createdAt           DateTime @default(now())

  @@index([userId, createdAt])
  @@index([conversationId, createdAt])
}

// A named chat thread. ChatMessage.conversationId points here (loose link — kept as String for back-compat with
// pre-existing messages). Title auto-derives from the first user turn; the user can rename. Soft-delete via archived.
model Conversation {
  id        String   @id @default(uuid())
  userId    String
  title     String?
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

// Safe, non-sensitive user memory/facts. Sensitive health/medical facts are rejected by the service.
model UserFact {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  key        String
  value      Json
  source     String
  confidence Float?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

// ============================================================
// GAMIFY-L4-11 — Honest gamification engine persistence — ADDITIVE ONLY.
// Server-authoritative: every row is derived from the trusted signal/event store
// (UserEvent type='cook_complete' etc.), NEVER client-asserted. All relations are
// onDelete: Cascade → erased automatically with the user (classified user_owned_active
// in retention-policy.ts). NO leaderboard/ranking/comparison data is ever stored.
// ============================================================

// One streak record per user. Weekly cadence (cook-days/week, not punishing daily pressure)
// with a single grace week ("freeze") so a busy week does not cruelly reset. Private only.
model UserStreak {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentWeeks Int      @default(0)
  longestWeeks Int      @default(0)
  graceUsed    Boolean  @default(false)
  lastCookWeek String? // ISO week key (e.g. 2026-W24) of the most recent counted week
  updatedAt    DateTime @updatedAt
}

// Unlocked achievements. (userId, achievementKey) unique → idempotent, no double-award.
model UserAchievement {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementKey String
  unlockedAt     DateTime @default(now())

  @@unique([userId, achievementKey])
  @@index([userId])
}

// Per-track mastery/progress (track = 'overall' or a cuisine/skill area). Honest, derived.
model UserProgress {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track     String
  level     Int      @default(1)
  levelName String   @default("novice")
  score     Float    @default(0)
  basis     String? // JSON explainability of how the level was earned
  updatedAt DateTime @updatedAt

  @@unique([userId, track])
  @@index([userId])
}

// Append-only award ledger. Each row records a real earned award (achievement/milestone/
// level-up) derived from signals — the anti-cheat record of truth.
model GamificationEvent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // 'achievement_unlocked' | 'streak_milestone' | 'mastery_levelup'
  refKey    String // achievementKey / milestone weeks / track
  detail    String? // JSON, PII-free
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ============================================================================================
// ADMIN CONTROL CENTER — Workflow automation engine (spec: docs/audit/ADMIN_CONTROL_CENTER_SPEC.md §B6).
// A lightweight in-house DAG runner over @nestjs/schedule + Prisma + EventOutbox (NOT Temporal/n8n).
// Definition (Workflow) vs run (WorkflowRun, JSONB step-state) vs alert (WorkflowAlert) are kept separate —
// definitions are small + edited rarely + version-pinned; runs are high-volume + pruned; alerts are the feed.
// ============================================================================================

model Workflow {
  id              String        @id @default(uuid())
  key             String        @unique // stable id, e.g. 'ai-cost-guardrail'
  name            String
  description     String?
  enabled         Boolean       @default(true)
  triggerType     String        @default("schedule") // 'schedule' | 'event' | 'manual'
  intervalSec     Int? // schedule trigger: run every N seconds (v1 scheduler; cron-expression support later)
  eventType       String? // event trigger: matches a UserEvent.type
  graph           Json // { nodes: [{ id, type, params, next? }] } — the DAG (React-Flow editor-ready)
  version         Int           @default(1) // bump on edit; a run pins the version it executed
  defaultSeverity String        @default("info") // info | warning | critical
  nextRunAt       DateTime? // the scheduler scans this (indexed)
  lastRunAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  runs            WorkflowRun[]

  @@index([enabled, triggerType, nextRunAt]) // the scheduler's hot query
  @@index([eventType])
}

model WorkflowRun {
  id              String    @id @default(uuid())
  workflowId      String
  workflow        Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowVersion Int       @default(1) // the definition version actually executed
  trigger         String    @default("schedule") // 'schedule' | 'event' | 'manual'
  status          String    @default("running") // running | succeeded | failed | skipped
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  durationMs      Int?
  stepState       Json? // { [nodeId]: { status, output, error?, ms } } — one JSONB column per run (Windmill)
  outcome         Json? // the final node output (alert payload / digest)
  error           String? // sanitized; no PII/secrets

  @@index([workflowId, startedAt])
  @@index([status, startedAt]) // open/failed runs + pruning scan
}

model WorkflowAlert {
  id             String   @id @default(uuid())
  workflowId     String // loose ref (no FK) — alerts are an audit log that outlives workflow edits/deletes
  workflowKey    String // denormalized so the Command feed reads without a join
  runId          String?
  severity       String   @default("info") // info | warning | critical
  title          String
  body           String
  metric         String?
  value          Float?
  threshold      Float?
  status         String   @default("open") // open | acknowledged | snoozed | resolved
  acknowledgedBy String?
  assignedTo     String?
  ownerRole      String?
  snoozedUntil   DateTime? // snooze re-surfaces the alert to the open queue once this passes (no cron needed)
  dueAt          DateTime?
  escalatedAt    DateTime?
  resolvedAt     DateTime?
  resolutionReason String?
  lastChangedBy  String?
  channelsSent   Json? // ['in_app'] now → ['slack','email'] later
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, severity, createdAt])
  @@index([status, dueAt])
  @@index([assignedTo, status])
  @@index([workflowKey, createdAt])
}
