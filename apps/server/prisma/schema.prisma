// apps/server/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  phone     String?  @unique
  email     String?  @unique
  name      String?
  avatar    String?   // 🆕 آواتار کاربر
  password  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  preferences        UserPreference?
  recipes            Recipe[]           @relation("UserRecipes")
  favorites          FavoriteRecipe[]
  mealPlans          MealPlan[]
  shoppingList       ShoppingList[]
  notifications      Notification[]
  tickets            SupportTicket[]
  sessions           UserSession[]
  events             UserEvent[]
  recommendationExposures RecommendationExposure[]
  featureContributionLogs FeatureContributionLog[]
  recommendationAttributions RecommendationAttributionEvent[]
  profile            UserBehaviorProfile?
  isAdmin            Boolean  @default(false)
  auditLogs          UserAuditLog[]
  dataAccessLogs     DataAccessLog[]
  consentLogs        ConsentLog[]
  preferenceHistories PreferenceHistory[]
  
  allergies          UserAllergy[]
  cuisines           UserCuisine[]
  healthGoals        UserHealthGoal[]
}

model UserPreference {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id])
  diet       String?
  skillLevel String?
  budget     String?
  updatedAt  DateTime @updatedAt
}

model Allergy {
  id    String        @id @default(uuid())
  name  String        @unique
  users UserAllergy[]

  @@map("allergies")
}

model Cuisine {
  id    String        @id @default(uuid())
  name  String        @unique
  users UserCuisine[]

  @@map("cuisines")
}

model HealthGoal {
  id    String          @id @default(uuid())
  name  String          @unique
  users UserHealthGoal[]

  @@map("health_goals")
}

model UserAllergy {
  userId    String
  allergyId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  allergy   Allergy @relation(fields: [allergyId], references: [id], onDelete: Cascade)

  @@id([userId, allergyId])
  @@map("user_allergies")
}

model UserCuisine {
  userId    String
  cuisineId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  cuisine   Cuisine @relation(fields: [cuisineId], references: [id], onDelete: Cascade)

  @@id([userId, cuisineId])
  @@map("user_cuisines")
}

model UserHealthGoal {
  userId       String
  healthGoalId String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  healthGoal   HealthGoal  @relation(fields: [healthGoalId], references: [id], onDelete: Cascade)

  @@id([userId, healthGoalId])
  @@map("user_health_goals")
}

model Recipe {
  id          String   @id @default(uuid())
  title       String
  description String?
  category    String
  region      String?
  difficulty  String?
  cookingTime Int?
  servings    Int?
  imageUrl    String?
  videoUrl    String?
  authorId    String?
  author      User?    @relation("UserRecipes", fields: [authorId], references: [id])
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  status      String?   @default("pending")
  adminNote   String?

  prepTime    String?
  totalTime   String?
  tools       String?   @default("[]")
  tips        String?   @default("[]")
  faq         String?   @default("[]")
  mealType    String?
  diet        String?
  categories  String?   @default("[]")
  allergens   String?   @default("[]")
  occasion    String?   @default("[]")
  cost        String?

  ingredients    RecipeIngredient[]
  steps          RecipeStep[]
  nutrition      Nutrition?
  searchTerms    SearchTerm[]
  favoriteBy     FavoriteRecipe[]
  mealSlots      MealSlot[]
  recommendationExposures RecommendationExposure[]
  featureContributionLogs FeatureContributionLog[]
  recommendationAttributionEvents RecommendationAttributionEvent[]
}

model RecipeIngredient {
  id        String  @id @default(uuid())
  recipeId  String
  recipe    Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  name      String
  amount    String?
  unit      String?
  notes     String?
  order     Int     @default(0)
}

model RecipeStep {
  id        String @id @default(uuid())
  recipeId  String
  recipe    Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  title     String?
  instruction String
  duration  Int?
  imageUrl  String?
  order     Int    @default(0)
}

model Nutrition {
  id         String @id @default(uuid())
  recipeId   String @unique
  recipe     Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  calories   Float?
  protein    Float?
  carbs      Float?
  fat        Float?
  fiber      Float?
}

model SearchTerm {
  id       String @id @default(uuid())
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  term     String
}

model FavoriteRecipe {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId  String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())

  @@unique([userId, recipeId])
}

model MealPlan {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slots     MealSlot[]

  @@unique([userId, weekStart])
}

model MealSlot {
  id         String   @id @default(uuid())
  mealPlanId String
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  dayOfWeek  Int
  mealType   String
  recipeId   String?
  recipe     Recipe?  @relation(fields: [recipeId], references: [id])
  notes      String?
}

model ShoppingList {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     ShoppingItem[]
}

model ShoppingItem {
  id             String   @id @default(uuid())
  shoppingListId String
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  name           String
  amount         String?
  unit           String?
  isChecked      Boolean  @default(false)
  category       String?
  addedAt        DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String
  isRead    Boolean  @default(false)
  data      String?
  createdAt DateTime @default(now())
}

model SupportTicket {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     String
  message     String
  status      String   @default("open")
  priority    String   @default("normal")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  replies     TicketReply[]
}

model TicketReply {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message   String
  isStaff   Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ===== مدل‌های ردیابی رفتار کاربران =====

model UserSession {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  startTime DateTime    @default(now())
  endTime   DateTime?
  device    String?
  ip        String?
  events    UserEvent[]
}

model UserEvent {
  id                  String               @id @default(uuid())
  userId              String
  user                User                 @relation(fields: [userId], references: [id])
  type                String
  timestamp           DateTime             @default(now())
  sessionId           String?
  session             UserSession?         @relation(fields: [sessionId], references: [id])
  page                String?
  duration            Int?
  payload             String?
  enrichment          String?
  signalObservations  SignalObservation[]  // 👈 اضافه شد

  @@index([userId, type, timestamp])
  @@index([timestamp])
  @@index([type])
}

model UserBehaviorProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])

  favoriteFoods   String?  @default("[]")
  dislikedFoods   String?  @default("[]")
  budgetRange     String?
  shoppingPattern String?  @default("[]")
  mealTiming      String?  @default("{}")
  cookingSkill    String?
  healthGoals     String?  @default("[]")
  motivationStyle String?
  consistencyScore Float?  @default(0.0)
  churnRiskScore   Float?  @default(0.0)
  familySize      Int?     @default(1)

  favoriteIngredients  String?  @default("[]")
  dislikedIngredients  String?  @default("[]")
  preferredMealTimes   String?  @default("{}")
  weeklyPatterns       String?  @default("{}")
  cookingFrequency     String?
  budgetScore          String?
  healthAdherenceScore Float?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ===== جداول ممیزی برای GDPR =====

model UserAuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model DataAccessLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  resource   String
  action     String
  details    String?
  ip         String?
  accessedAt DateTime @default(now())

  @@index([userId, accessedAt])
}

model ConsentLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  granted   Boolean  @default(true)
  ip        String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type])
}

model PreferenceHistory {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fieldName  String
  oldValue   String?
  newValue   String?
  changedAt  DateTime @default(now())

  @@index([userId, changedAt])
}

// ===== 🆕 مدل‌های Feature Store =====

model UserFeatureVector {
  userId    String   @id
  features  Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}

model UserFeature {
  id         String   @id @default(uuid())
  userId     String
  featureKey String
  value      Float    @default(0.0)
  updatedAt  DateTime @updatedAt

  @@unique([userId, featureKey])
  @@index([featureKey, value])
}

// ===== 🆕 مدل‌های لایه Outcomes =====

model UserOutcome {
  id                String   @id @default(uuid())
  userId            String
  metricName        String
  baselineValue     Float?
  metricValue       Float    @default(0.0)
  improvementPercent Float?
  trend             Float?
  period            String   @default("weekly")
  sources           Json?
  recordedAt        DateTime @default(now())

  @@index([userId, metricName, recordedAt])
}

// ===== 🆕 مدل‌های Identity =====

model UserIdentityDimension {
  userId          String
  dimensionKey    String
  value           Float    @default(0.0)
  confidence      Float    @default(0.0)
  evidenceCount   Int      @default(0)
  lastEvidenceAt  DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@id([userId, dimensionKey])
}

model UserBehaviorTimeline {
  id            String   @id @default(uuid())
  userId        String
  dimensionKey  String
  value         Float
  recordedAt    DateTime @default(now())

  @@index([userId, dimensionKey, recordedAt])
}

// ===== 🆕 مدل‌های Behavioral Signals =====

model SignalObservation {
  id          String   @id @default(uuid())
  userId      String
  signalName  String
  eventId     String
  weight      Float    @default(0.0)
  observedAt  DateTime @default(now())
  
  event       UserEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model RecommendationExposure {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId     String
  recipe       Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  source       String   @default("recommendation")
  viewedAt     DateTime @default(now())
  scorePenalty Float    @default(0.0)

  @@index([userId, recipeId, viewedAt])
}

model FeatureContributionLog {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId     String
  recipe       Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  featureKey   String
  contribution Float
  finalScore   Float
  createdAt    DateTime @default(now())

  @@index([userId, recipeId, createdAt])
  @@index([featureKey, contribution])
}

model RecommendationAttributionEvent {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId    String
  recipe      Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  eventType   String
  value       Float    @default(0.0)
  source      String   @default("recommendation")
  occurredAt  DateTime @default(now())

  @@index([userId, recipeId, occurredAt])
  @@index([eventType, value])
}

model RecommendationMetrics {
  id                  String   @id @default(uuid())
  metricDate          DateTime @default(now())
  windowDays          Int      @default(7)
  totalImpressions    Int      @default(0)
  totalClicks         Int      @default(0)
  totalSaves          Int      @default(0)
  totalCooks          Int      @default(0)
  totalDismisses      Int      @default(0)
  totalExposures      Int      @default(0)
  clickThroughRate    Float    @default(0.0)
  saveRate            Float    @default(0.0)
  cookRate            Float    @default(0.0)
  frictionRate        Float    @default(0.0)
  recommendationQuality Float  @default(0.0)
  recommendationReward  Float  @default(0.0)
  topSignals          Json?
  topFeatures         Json?
  createdAt           DateTime @default(now())

  @@unique([metricDate, windowDays])
  @@index([metricDate, windowDays])
}

model UserBehaviorSignal {
  userId        String
  signalName    String
  signalDomain  String
  signalType    String
  value         Float    @default(0.0)
  confidence    Float    @default(0.0)
  sampleSize    Int      @default(0)
  consistency   Float    @default(0.0)
  halfLifeDays  Int      @default(30)
  lastDetected  DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@id([userId, signalName])
}

// ===== 🆕 Domain Snapshots =====

model UserEngagementSnapshot {
  userId                  String   @id
  avgSessionDuration      Float    @default(0.0)
  avgTimeBetweenSessions  Float    @default(0.0)
  daysSinceLastMealPlan   Int      @default(0)
  activeDaysLast30        Int      @default(0)
  schemaVersion           Int      @default(1)
  updatedAt               DateTime @updatedAt
}

model UserHealthSnapshot {
  userId                  String   @id
  mealPlanCompletionRate  Float    @default(0.0)
  goalCompletionRate      Float    @default(0.0)
  nutritionViewFrequency  Float    @default(0.0)
  hasActiveHealthGoal     Boolean  @default(false)
  schemaVersion           Int      @default(1)
  updatedAt               DateTime @updatedAt
}

model UserIdentitySnapshot {
  userId                  String   @id
  recipeSaveRate          Float    @default(0.0)
  recipeCookRate          Float    @default(0.0)
  shoppingCompletionRate  Float    @default(0.0)
  aiAcceptanceRate        Float    @default(0.0)
  aiDismissRate           Float    @default(0.0)
  schemaVersion           Int      @default(1)
  updatedAt               DateTime @updatedAt
}

model UserRetentionSnapshot {
  userId                String   @id
  daysSinceLastActive   Int      @default(0)
  sessionTrend          Float    @default(0.0)
  engagementTrend       Float    @default(0.0)
  retentionScore        Float    @default(0.0)
  churnRisk             Float    @default(0.0)
  schemaVersion         Int      @default(1)
  updatedAt             DateTime @updatedAt
}
// ===== 🆕 مدل‌های A/B Testing =====

model Experiment {
  id        String   @id @default(uuid())
  name      String
  variantA  Json     // وزن‌های گروه A
  variantB  Json     // وزن‌های گروه B
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  
  assignments ExperimentAssignment[]
}

model ExperimentAssignment {
  id           String     @id @default(uuid())
  userId       String
  experimentId String
  variant      String     // "A" or "B"
  experiment   Experiment @relation(fields: [experimentId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([userId, experimentId])
}
