// apps/server/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  phone     String?  @unique
  email     String?  @unique
  googleId  String?  @unique
  authProvider String?
  name      String?
  avatar    String? // 🆕 آواتار کاربر
  password  String?
  locale    String? // L1: BCP-47 locale (e.g. nl-NL) — the cohort/region join key for cold-start priors
  country   String? // L1: ISO-3166 country (e.g. NL) — regional-prior scope for the Europe-general launch
  // Onboarding v1 — device-keyed passwordless GUEST spine: a silent real User+JWT so server-side safeIds runs
  // for every visitor (anonymous = allergy filter OFF was the bug). deviceKey (a high-entropy client UUID) lets a
  // returning guest on the same device resume the SAME user (keeps declared allergies). Claimed → registered later.
  isGuest   Boolean  @default(false)
  deviceKey String?  @unique
  onboardingCompletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  preferences                UserPreference?
  recipes                    Recipe[]                         @relation("UserRecipes")
  favorites                  FavoriteRecipe[]
  mealPlans                  MealPlan[]
  shoppingList               ShoppingList[]
  notifications              Notification[]
  tickets                    SupportTicket[]
  sessions                   UserSession[]
  events                     UserEvent[]
  recommendationExposures    RecommendationExposure[]
  featureContributionLogs    FeatureContributionLog[]
  recommendationAttributions RecommendationAttributionEvent[]
  profile                    UserBehaviorProfile?
  isAdmin                    Boolean                          @default(false)
  adminRole                  String                           @default("user")
  // Admin moderation — account suspension. Login is gated on isBanned (auth.service); bannedAt/banReason
  // give the audit trail. Additive + default-false → every existing user is unaffected (not banned).
  isBanned                   Boolean                          @default(false)
  bannedAt                   DateTime?
  banReason                  String?
  // Stateless-JWT invalidation epoch: bumped on force-logout / ban / admin password-reset. The jwt strategy
  // rejects any token whose epoch != the user's current epoch → a REAL kick (deleting sessions alone can't,
  // since the token is self-contained). Default 0; tokens minted without an epoch claim compare as 0 (back-compat).
  sessionEpoch               Int                              @default(0)
  auditLogs                  UserAuditLog[]
  dataAccessLogs             DataAccessLog[]
  consentLogs                ConsentLog[]
  preferenceHistories        PreferenceHistory[]

  allergies   UserAllergy[]
  cuisines    UserCuisine[]
  healthGoals UserHealthGoal[]

  // AI Core v1 (E47-A2) — additive
  aiCallLogs   AICallLog[]
  chatMessages ChatMessage[]
  userFacts    UserFact[]
  aiSpendAlerts AiSpendAlert[] // E47-A10C spend-alert foundation (SetNull on delete)

  // E39-1A erasure FK repair — behavioral / intelligence relations (additive)
  featureVector         UserFeatureVector?
  features              UserFeature[]
  outcomes              UserOutcome[]
  identityDimensions    UserIdentityDimension[]
  behaviorTimelines     UserBehaviorTimeline[]
  signalObservations    SignalObservation[]
  behaviorSignals       UserBehaviorSignal[]
  engagementSnapshot    UserEngagementSnapshot?
  healthSnapshot        UserHealthSnapshot?
  identitySnapshot      UserIdentitySnapshot?
  retentionSnapshot     UserRetentionSnapshot?
  experimentAssignments ExperimentAssignment[]

  // E39-1B erasure-proof ledger (audit-long; SetNull so it survives deletion)
  erasureEvents ErasureEvent[]

  // GAMIFY-L4-11 — honest gamification (additive; all Cascade → erasure-safe)
  gamificationStreak       UserStreak?
  gamificationAchievements UserAchievement[]
  gamificationProgress     UserProgress[]
  gamificationEvents       GamificationEvent[]

  // L0 — living-intelligence core (additive; Cascade → erasure-safe)
  userConsents UserConsent[]
  pantryItems  PantryItem[]
  passwordResetCodes PasswordResetCode[]
  authOtpCodes       AuthOtpCode[]
}

model PasswordResetCode {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([userId, createdAt])
  @@index([expiresAt])
}

model AuthOtpCode {
  id         String    @id @default(uuid())
  phone      String
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  purpose    String    @default("login")
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([phone, purpose, consumedAt])
}

model UserPreference {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  diet       String?
  skillLevel String?
  budget     String?
  updatedAt  DateTime @updatedAt
}

model Allergy {
  id    String        @id @default(uuid())
  name  String        @unique
  users UserAllergy[]

  @@map("allergies")
}

model Cuisine {
  id    String        @id @default(uuid())
  name  String        @unique
  users UserCuisine[]

  @@map("cuisines")
}

model HealthGoal {
  id    String           @id @default(uuid())
  name  String           @unique
  users UserHealthGoal[]

  @@map("health_goals")
}

model UserAllergy {
  userId    String
  allergyId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  allergy   Allergy @relation(fields: [allergyId], references: [id], onDelete: Cascade)

  @@id([userId, allergyId])
  @@map("user_allergies")
}

model UserCuisine {
  userId    String
  cuisineId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  cuisine   Cuisine @relation(fields: [cuisineId], references: [id], onDelete: Cascade)

  @@id([userId, cuisineId])
  @@map("user_cuisines")
}

model UserHealthGoal {
  userId       String
  healthGoalId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  healthGoal   HealthGoal @relation(fields: [healthGoalId], references: [id], onDelete: Cascade)

  @@id([userId, healthGoalId])
  @@map("user_health_goals")
}

model Recipe {
  id          String   @id @default(uuid())
  title       String
  description String?
  category    String
  region      String?
  difficulty  String?
  cookingTime Int?
  servings    Int?
  imageUrl    String?
  videoUrl    String?
  authorId    String?
  author      User?    @relation("UserRecipes", fields: [authorId], references: [id], onDelete: SetNull)
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  status    String? @default("pending")
  adminNote String?

  prepTime   String?
  totalTime  String?
  tools      String? @default("[]")
  tips       String? @default("[]")
  faq        String? @default("[]")
  mealType   String?
  diet       String?
  categories String? @default("[]")
  allergens  String? @default("[]")
  occasion   String? @default("[]")
  cost       String?

  // S3 Option-2 — structured richness (additive; display-only). The importer previously flattened these
  // four authored arrays into one `tips` blob; now persisted separately so the UI can render distinct
  // premium sections. `dishType` is the authored classification (display-only — the S5 course gate still
  // derives course from category+mealType and is NOT repointed here). None is safety-relevant.
  chefTips           String? @default("[]")
  commonMistakes     String? @default("[]")
  servingSuggestions String? @default("[]")
  substitutions      String? @default("[]")
  dishType           String? @default("[]")

  // GRIS v2 — the full Garnish Recipe Intelligence Standard object (story, whyItWorks, glance, skillsLearned,
  // dietary, rich ingredients/steps, finish, troubleshooting, variations, keep, serveWith, nourishment, faq).
  // Additive Json blob; the recipe page renders it when present, with graceful fallback to the flat fields.
  gris         Json?
  // GRIS dietary surface (queryable for the planner/preference filter; soft "no pork" avoidance).
  containsPork Boolean @default(false)

  ingredients                     RecipeIngredient[]
  steps                           RecipeStep[]
  nutrition                       Nutrition?
  searchTerms                     SearchTerm[]
  favoriteBy                      FavoriteRecipe[]
  mealSlots                       MealSlot[]
  recommendationExposures         RecommendationExposure[]
  featureContributionLogs         FeatureContributionLog[]
  recommendationAttributionEvents RecommendationAttributionEvent[]
}

model Ingredient {
  id                  String   @id
  code                String   @unique
  status              String?
  version             String?
  batch               Json?
  nameFa              String?
  nameEn              String?
  category            String?
  subCategory         String?
  ingredientState     Json?
  dietFlags           Json?
  allergens           Json?
  nutritionPer100g    Json?
  nutritionConfidence Json?
  // Amount→gram conversion layer: per-unit grams for the non-mass units the recipe corpus uses («عدد»،
  // «پیمانه»، «قاشق غذاخوری»، «حبه» …), each entry source- + confidence-flagged (mined from the corpus and/or
  // a documented culinary reference). ESTIMATED until USDA portion-locked. Nullable → legacy rows stay
  // unknown; the compute-nutrition path only trusts a fully-resolved dish. Populated by
  // scripts/data/backfill-ingredient-gram-conversions.cjs. See Nutrition.source for the same provenance pattern.
  gramConversions     Json?
  tasteProfile        Json?
  textureProfile      Json?
  cookingBehavior     Json?
  healthContext       Json?
  substitutionOptions Json?
  media               Json?
  aiContext           Json?
  marketAvailability  Json?
  cuisineRelevance    Json?
  dataQuality         Json?
  recipeInputAliases  Json?
  resolverDefaults    Json?
  raw                 Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  recipeIngredients RecipeIngredient[]
  pantryItems       PantryItem[] // L0 (SetNull on delete → pantry rows survive a dictionary edit)

  @@index([category])
  @@index([code])
}

model RecipeIngredient {
  id           String      @id @default(uuid())
  recipeId     String
  recipe       Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String?
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  name         String
  amount       String?
  unit         String?
  notes        String?
  order        Int         @default(0)

  @@index([ingredientId])
}

model RecipeStep {
  id          String  @id @default(uuid())
  recipeId    String
  recipe      Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  title       String?
  instruction String
  duration    Int?
  imageUrl    String?
  order       Int     @default(0)
}

model Nutrition {
  id       String @id @default(uuid())
  recipeId String @unique
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  calories Float?
  protein  Float?
  carbs    Float?
  fat      Float?
  fiber    Float?
  // Provenance of the macro values (nullable → legacy rows stay unknown). 'estimated_ingredient_gris_v1' =
  // deterministically computed (GRIS weightG × source-locked per-100g ÷ servings) by the Persian backfill,
  // flagged ESTIMATED until USDA source-locked. Lets a later USDA pass distinguish estimates from locked data.
  source   String?
}

model SearchTerm {
  id       String @id @default(uuid())
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  term     String
}

model FavoriteRecipe {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId String
  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  addedAt  DateTime @default(now())

  @@unique([userId, recipeId])
}

model MealPlan {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slots MealSlot[]

  @@unique([userId, weekStart])
}

model MealSlot {
  id         String   @id @default(uuid())
  mealPlanId String
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  dayOfWeek  Int
  mealType   String
  recipeId   String?
  recipe     Recipe?  @relation(fields: [recipeId], references: [id])
  notes      String?
  cookedAt   DateTime? // set when the user marks this slot cooked (the "پختم" signature interaction); null = not cooked
  servings   Int?      // portions to cook for this slot; null = use the recipe's base servings. Scales the shopping list.
}

model ShoppingList {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ShoppingItem[]
}

model ShoppingItem {
  id             String       @id @default(uuid())
  shoppingListId String
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  name           String
  amount         String?
  unit           String?
  isChecked      Boolean      @default(false)
  checkedAt      DateTime?
  category       String?
  ingredientId   String? // soft ref to the dictionary Ingredient (enables merge / pantry-subtraction / aisle)
  source         String? // 'manual' | 'recipe:<id>' | 'plan' — re-sync can replace plan items without nuking manual
  sortOrder      Int          @default(0)
  addedAt        DateTime     @default(now())

  @@index([shoppingListId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String
  isRead    Boolean  @default(false)
  data      String?
  createdAt DateTime @default(now())
}

model SupportTicket {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  message   String
  status    String   @default("open") // open | pending | in_progress | resolved | closed (validated in service)
  priority  String   @default("normal") // low | normal | high | urgent (now actually used + filterable)
  category  String   @default("general") // general | account | technical | billing | feature | content
  assigneeId String? // admin user id this ticket is assigned to (plain column, no FK — like UserEvent.sessionId)
  tags      String[] @default([]) // free-form admin labels
  rating    Int? // 1–5 user satisfaction, set after resolution
  ratingComment String?
  firstResponseAt DateTime? // first STAFF reply → SLA first-response time
  resolvedAt      DateTime? // moved to resolved/closed → SLA resolution time
  lastReplyAt     DateTime? // newest reply (sort by activity / "needs attention")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  replies TicketReply[]
  notes   TicketNote[]
}

model TicketReply {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message   String
  isStaff   Boolean       @default(false)
  authorId  String? // who wrote it (user or admin id), for accountability
  createdAt DateTime      @default(now())
}

// Internal admin-only notes on a ticket — NEVER returned to the user (unlike TicketReply).
model TicketNote {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String? // admin who wrote the note
  body      String
  createdAt DateTime      @default(now())
}

// ===== مدل‌های ردیابی رفتار کاربران =====

model UserSession {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  startTime DateTime    @default(now())
  endTime   DateTime?
  device    String?
  ip        String?
}

model UserEvent {
  id                 String              @id @default(uuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type               String
  timestamp          DateTime            @default(now())
  // Client-generated session correlation id. Plain indexed column (NO foreign key): sessions are DERIVED at
  // analysis time by the 30-min inactivity gap (PostHog/Amplitude model), so an event never blocks on a
  // UserSession row existing first. UserSession remains a standalone model (GDPR export/erasure/retention).
  sessionId          String?
  page               String?
  duration           Int?
  payload            String?
  enrichment         String?
  recipeId           String? // L0: denormalized from payload at write-time for fast recipe-level signal queries (nullable → existing rows + reader unchanged)
  consentPurpose     String? // L0: GDPR provenance — the consent purpose this event was collected under ('analytics' baseline = legitimate-interest; 'personalization' when granted under the gate). Mirrors the canonical envelope consentPurpose enum.
  signalObservations SignalObservation[] // 👈 اضافه شد

  @@index([userId, type, timestamp])
  @@index([timestamp])
  @@index([type])
  @@index([userId, recipeId, timestamp])
  @@index([consentPurpose]) // mirrors the migration's index (DSAR/observability provenance audits)
  @@index([sessionId]) // session analytics group by sessionId (sessions derived by inactivity gap)
}

// L0 — durable transactional-outbox for event routing ("capture every second" / no lost signals). Every
// routable UserEvent gets one row (eventId unique → idempotent enqueue). The fast path routes in-process and
// marks it done; a scheduled drain re-routes anything still pending after a grace period (e.g. a process crash
// between the event write and routing) → at-least-once delivery into the signal engine.
model EventOutbox {
  id          String    @id @default(uuid())
  eventId     String    @unique
  status      String    @default("pending") // pending | processing | done | dead (exhausted retries → dead-letter)
  attempts    Int       @default(0)
  error       String?
  createdAt   DateTime  @default(now())
  claimedAt   DateTime? // when a drain claimed it (pending→processing); a reaper revives rows stuck past a TTL
  processedAt DateTime?

  @@index([status, createdAt])
  @@index([status, claimedAt])
}

model UserBehaviorProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  favoriteFoods    String? @default("[]")
  dislikedFoods    String? @default("[]")
  budgetRange      String?
  shoppingPattern  String? @default("[]")
  mealTiming       String? @default("{}")
  cookingSkill     String?
  healthGoals      String? @default("[]")
  motivationStyle  String?
  consistencyScore Float?  @default(0.0)
  churnRiskScore   Float?  @default(0.0)
  familySize       Int?    @default(1)

  favoriteIngredients  String? @default("[]")
  dislikedIngredients  String? @default("[]")
  preferredMealTimes   String? @default("{}")
  weeklyPatterns       String? @default("{}")
  cookingFrequency     String?
  budgetScore          String?
  healthAdherenceScore Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===== جداول ممیزی برای GDPR =====

model UserAuditLog {
  id        String   @id @default(uuid())
  userId    String? // E39-1B: nullable for audit-long survival (SetNull on erasure)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorId   String?
  targetId  String?
  targetType String?
  action    String
  reason    String?
  riskLevel String?
  details   String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([actorId, createdAt])
  @@index([targetId, createdAt])
  @@index([action, createdAt])
}

model DataAccessLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  resource   String
  action     String
  details    String?
  ip         String?
  accessedAt DateTime @default(now())

  @@index([userId, accessedAt])
}

model ConsentLog {
  id        String   @id @default(uuid())
  userId    String? // E39-1B: nullable for audit-long survival (SetNull on erasure)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      String
  // E52/B2B-B0: processing purpose the user consented to (additive, nullable).
  // Mirrors the canonical envelope consentPurpose: core | analytics | personalization | b2b_aggregate | community.
  purpose   String?
  granted   Boolean  @default(true)
  ip        String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type])
}

// E39-1B: audit-long, PII-FREE erasure-proof ledger. Survives user deletion (userId SetNull on
// erasure; `subjectHash` is the durable, non-reversible subject reference). Written by the future
// transactional erasure service (E39-1C). No email/phone/name/raw profile/secrets stored.
model ErasureEvent {
  id          String   @id @default(uuid())
  userId      String? // SetNull on erasure — proof survives without an active user link
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  subjectHash String // sha256(salt + userId) — non-reversible reference to the (deleted) subject
  action      String // e.g. user_erasure_requested | user_erasure_completed
  status      String // requested | completed | failed
  reason      String?
  metadata    Json // PII-free only (assertNoPIIInMetadata enforced in ErasureAuditService)
  createdAt   DateTime @default(now())

  @@index([subjectHash, createdAt])
  @@index([action, status])
}

model PreferenceHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fieldName String
  oldValue  String?
  newValue  String?
  changedAt DateTime @default(now())

  @@index([userId, changedAt])
}

// ===== 🆕 مدل‌های Feature Store =====

model UserFeatureVector {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  features  Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}

model UserFeature {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  featureKey String
  value      Float    @default(0.0)
  updatedAt  DateTime @updatedAt

  @@unique([userId, featureKey])
  @@index([featureKey, value])
}

// ===== 🆕 مدل‌های لایه Outcomes =====

model UserOutcome {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  metricName         String
  baselineValue      Float?
  metricValue        Float    @default(0.0)
  improvementPercent Float?
  trend              Float?
  period             String   @default("weekly")
  sources            Json?
  recordedAt         DateTime @default(now())

  @@index([userId, metricName, recordedAt])
}

// ===== 🆕 مدل‌های Identity =====

model UserIdentityDimension {
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dimensionKey   String
  value          Float    @default(0.0)
  confidence     Float    @default(0.0)
  evidenceCount  Int      @default(0)
  lastEvidenceAt DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@id([userId, dimensionKey])
}

model UserBehaviorTimeline {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dimensionKey String
  value        Float
  recordedAt   DateTime @default(now())

  @@index([userId, dimensionKey, recordedAt])
}

// ===== 🆕 مدل‌های Behavioral Signals =====

model SignalObservation {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  signalName String
  eventId    String
  weight     Float    @default(0.0)
  observedAt DateTime @default(now())

  // L0: full typed-signal contract (all nullable/defaulted → existing writer at
  // recipe.signal-processor.ts and reader at recommendation-shadow-a8-adapters.ts stay byte-identical).
  recipeId   String? // which recipe drove this signal (was unrecoverable; lived only in UserEvent.payload)
  dimension  String? // e.g. "taste" / "nutrition" — maps a row into a Food-DNA dimension
  value      String? // e.g. cuisine token "persian" — the typed value carried by the signal
  confidence Float? // per-observation evidence strength (cook=1 > favorite=0.8 > view=0.5)
  source     String?  @default("legacy_event") // event type / extractor that produced it

  event UserEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId, signalName, observedAt])
  @@index([userId, recipeId])
}

// L0 — consent-at-ingest (opt-IN, versioned, point-in-time, with lawful basis). Deliberately SEPARATE
// from ConsentLog (which is opt-OUT latest-state, audit_long, read by erasure/export/retention) so those
// consumers stay byte-identical. Purpose strings are constrained in app code to ConsentPurposeEnum
// (core | analytics | personalization | b2b_aggregate | community | notifications). Operational gating
// record → Cascade (the legal proof survives via ConsentLog + ErasureEvent).
model UserConsent {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose       String
  status        String    @default("granted") // granted | withdrawn
  lawfulBasis   String    @default("consent") // consent | legitimate_interest | contract
  policyVersion String?
  source        String? // onboarding | settings | api | ingest
  ip            String?
  grantedAt     DateTime  @default(now())
  withdrawnAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, purpose])
}

// L0 — user pantry / on-hand inventory (feeds pantry-aware personalization + shopping de-dup). Mirrors
// the ShoppingItem shape. ingredientId is a soft link (SetNull) so a dictionary edit never drops a pantry row.
model PantryItem {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredientId String?
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  name         String
  amount       String?
  unit         String?
  addedAt      DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId])
  @@index([ingredientId])
}

model RecommendationExposure {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId     String
  recipe       Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  source       String   @default("recommendation")
  viewedAt     DateTime @default(now())
  scorePenalty Float    @default(0.0)

  @@index([userId, recipeId, viewedAt])
}

model FeatureContributionLog {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId     String
  recipe       Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  featureKey   String
  contribution Float
  finalScore   Float
  createdAt    DateTime @default(now())

  @@index([userId, recipeId, createdAt])
  @@index([featureKey, contribution])
}

// L0/L1 foundation — the served-slate log ("counters first-class"). For every recommendation actually
// returned we capture rank (position) + the score it was served at + a propensity (selection probability).
// This is exactly what off-policy / counterfactual learning (IPS) needs from day one; without position +
// propensity the exposure→reward signal can never be debiased, and it is unrecoverable after the fact.
// Reward is DERIVED by joining to RecommendationAttributionEvent / UserEvent (cook/view after servedAt).
// Written fire-and-forget at serve time; default-safe (a write fault never affects the user response).
// No FK (mirrors RecommendationShadowTrace) to keep the hot path lean.
model RecommendationServedItem {
  id          String   @id @default(uuid())
  userId      String
  recipeId    String
  position    Int // 0-based rank in the served slate
  score       Float // finalScore the ranker assigned
  propensity  Float // selection probability (softmax over the slate; a smoothed exposure weight for today's deterministic ranker, replaced by the true randomized propensity at L1's bandit)
  requestId   String? // L1: groups one served slate; echoed back on the reward/attribution event so exposure→reward is JOINABLE at (recipe,position,propensity) grain for off-policy learning (unrecoverable if missed)
  surface     String? // home | discover | search
  contextJson String? // serialized real-time context (timeOfDay/season/occasion) for counterfactual replay
  sessionId   String?
  servedAt    DateTime @default(now())

  @@index([userId, servedAt])
  @@index([recipeId, servedAt])
  @@index([requestId])
}

model RecommendationAttributionEvent {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId   String
  recipe     Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  eventType  String
  value      Float    @default(0.0)
  source     String   @default("recommendation")
  requestId  String? // L1: the served-slate id this reward is attributed to (echoed from the recommendation) → joins exposure↔reward for off-policy learning
  occurredAt DateTime @default(now())

  @@index([userId, recipeId, occurredAt])
  @@index([eventType, value])
  @@index([requestId])
}

// L1 step 4 — learned per-(recipe × scope) reward prior for empirical-Bayes hierarchical shrinkage.
// scope = 'population' | 'cohort' | 'person'; scopeKey = '' (population) | deriveCohortKey(facets) | userId.
// `mean` & `populationMu` are CENTERED deviations in [-1,1] (IPS-weighted realized reward minus the global slate
// baseline), so an empty/neutral table yields a 0 posterior → the ranker stays byte-identical at cold start.
// `n` is the IPS EFFECTIVE sample size (Σ propensity-weights), so κ-shrinkage down-trusts thin/over-weighted
// estimates. JOINABLE-but-biased until L1.5 randomized propensity (NOT counterfactually unbiased).
// No FK (mirrors RecommendationServedItem) → person rows do NOT cascade on user erasure; the erasure sweep
// MUST delete scope='person', scopeKey=userId explicitly.
model RecipePrior {
  id           String   @id @default(uuid())
  recipeId     String
  scope        String // population | cohort | person
  scopeKey     String // '' | deriveCohortKey(...) | userId
  n            Float    @default(0) // IPS effective sample size Σw behind `mean`
  mean         Float    @default(0) // centered IPS-weighted reward deviation in [-1,1]
  posterior    Float    @default(0) // cached hierarchicalPrior output (convenience; recomputed at read)
  populationMu Float    @default(0) // centered curated cold-start anchor (population rows; 0 elsewhere)
  rewardM2     Float    @default(0) // Welford running variance (forward-looking; unused on the read path)
  updatedAt    DateTime @updatedAt

  @@unique([recipeId, scope, scopeKey]) // the learner's upsert key
  @@index([scope, scopeKey]) // load a whole cohort's priors in one query
  @@index([recipeId]) // batch-fetch all priors for a candidate set in one findMany
}

model RecommendationMetrics {
  id                    String   @id @default(uuid())
  metricDate            DateTime @default(now())
  windowDays            Int      @default(7)
  totalImpressions      Int      @default(0)
  totalClicks           Int      @default(0)
  totalSaves            Int      @default(0)
  totalCooks            Int      @default(0)
  totalDismisses        Int      @default(0)
  totalExposures        Int      @default(0)
  clickThroughRate      Float    @default(0.0)
  saveRate              Float    @default(0.0)
  cookRate              Float    @default(0.0)
  frictionRate          Float    @default(0.0)
  recommendationQuality Float    @default(0.0)
  recommendationReward  Float    @default(0.0)
  topSignals            Json?
  topFeatures           Json?
  createdAt             DateTime @default(now())

  @@unique([metricDate, windowDays])
  @@index([metricDate, windowDays])
}

// E18/E43-A7: redacted SHADOW recommendation decision trace (additive, no FK, default writes OFF).
// Stores ONLY minimized/redacted shadow comparison data — never raw recipe body, raw user text, AI
// prompt/output, PII, or medical/protected labels. Not user-facing; does not affect live ranking.
model RecommendationShadowTrace {
  id                String   @id @default(uuid())
  userId            String?
  requestId         String?
  experimentKey     String?
  liveFingerprint   String
  shadowFingerprint String
  topKOverlap       Float?
  rankShiftCount    Int?
  majorDivergence   Boolean
  reasonCodes       Json
  summary           Json
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([experimentKey])
  @@index([createdAt])
}

model UserBehaviorSignal {
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  signalName   String
  signalDomain String
  signalType   String
  value        Float    @default(0.0)
  confidence   Float    @default(0.0)
  sampleSize   Int      @default(0)
  consistency  Float    @default(0.0)
  halfLifeDays Int      @default(30)
  lastDetected DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@id([userId, signalName])
}

