# Garnish OS — web environment template
# Copy to `apps/web/.env` and fill in. Never commit the real .env.

# Backend API base URL
VITE_API_URL=http://localhost:3000

# PostHog analytics (E4). Analytics only runs AFTER the user grants consent.
# Leave the key empty to keep analytics fully disabled.
# Use the EU host for GDPR data residency.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
