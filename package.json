{ 
  "name": "garnish-os", 
  "private": true, 
  "type": "module",
  "scripts": { 
    "dev": "turbo run dev", 
    "build": "turbo run build", 
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "coverage:scan": "node tools/coverage/coverage-scan.mjs",
    "coverage:check": "node tools/coverage/coverage-check.mjs",
    "coverage:matrix": "node tools/coverage/coverage-matrix.mjs",
    "data:validate:ingredients": "pnpm --dir apps/server data:validate:ingredients",
    "data:import:ingredients": "pnpm --dir apps/server data:import:ingredients",
    "data:validate:phase-one": "pnpm --dir apps/server data:validate:phase-one",
    "data:import:phase-one": "pnpm --dir apps/server data:import:phase-one",
    "recipes:validate:v0.6.1": "pnpm --dir apps/server recipes:validate:v0.6.1",
    "recipes:import:v0.6.1:dry": "pnpm --dir apps/server recipes:import:v0.6.1:dry",
    "recipes:import:v0.6.1": "pnpm --dir apps/server recipes:import:v0.6.1",
    "ai:eval:regression": "pnpm --dir apps/server ai:eval:regression",
