    "recsys:eval": "pnpm --dir apps/server recsys:eval",
    "analytics:eval:event-envelope": "pnpm --dir apps/server analytics:eval:event-envelope",
    "analytics:eval:event-producers": "pnpm --dir apps/server analytics:eval:event-producers",
    "behavior:eval:signals": "pnpm --dir apps/server behavior:eval:signals",
    "behavior:eval:profile": "pnpm --dir apps/server behavior:eval:profile",
    "recommendation:eval:decision-intelligence": "pnpm --dir apps/server recommendation:eval:decision-intelligence",
    "recommendation:eval:shadow-runtime": "pnpm --dir apps/server recommendation:eval:shadow-runtime",
    "recommendation:eval:shadow-a7": "pnpm --dir apps/server recommendation:eval:shadow-a7",
    "recommendation:eval:shadow-a8": "pnpm --dir apps/server recommendation:eval:shadow-a8",
    "recommendation:eval:shadow-a9": "pnpm --dir apps/server recommendation:eval:shadow-a9",
    "recommendation:eval:shadow-a10": "pnpm --dir apps/server recommendation:eval:shadow-a10",
    "recommendation:eval:lab-a11": "pnpm --dir apps/server recommendation:eval:lab-a11",
    "recommendation:eval:founder-review-a12": "pnpm --dir apps/server recommendation:eval:founder-review-a12",
    "recommendation:eval:experiment-a13": "pnpm --dir apps/server recommendation:eval:experiment-a13",
    "recommendation:eval:activation-a14": "pnpm --dir apps/server recommendation:eval:activation-a14",
    "recipes:validate:international-150": "pnpm --dir apps/server recipes:validate:international-150",
    "recipes:import:international-150:dry-run": "pnpm --dir apps/server recipes:import:international-150:dry-run",
    "recipes:import:international-150": "pnpm --dir apps/server recipes:import:international-150",
    "recipes:verify:international-150": "pnpm --dir apps/server recipes:verify:international-150"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "prettier": "^3.2.5",
    "globals": "^17.0.0",
    "turbo": "^1.13.3"
  },
  "packageManager": "pnpm@9.1.0", 
  "engines": { 
    "node": ">=18" 
  } 
